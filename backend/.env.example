# ══════════════════════════════════════════════════════════════════════════════
# CRACKED? — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your own values.
# Never commit .env with real secrets.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database (Neon PostgreSQL — required) ───
# Connection string from your Neon console: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgres://user:password@ep-cool-sample.us-east-2.aws.neon.tech/cracked?sslmode=require

# ─── Session Secret ───
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_random_session_secret_change_in_production

# ─── Case proposal moderation ───
# Comma-separated emails that can review and publish community case proposals.
CASE_MODERATOR_EMAILS=moderator@example.com

# ─── Client Origin (for CORS + OAuth redirect URIs) ───
# Production: your Vercel frontend origin (for example, https://your-project.vercel.app)
# Development: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# ─── Server ───
PORT=8080
NODE_ENV=development

# ─── Cloudinary (Image storage) ───
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── OAuth (optional — GitHub/Google login) ───
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Client Base URL (for OAuth callbacks) ───
# Use the same origin as CLIENT_ORIGIN.
BASE_URL=http://localhost:5173

# Integration tests must use a separate, disposable PostgreSQL database.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/cracked_test?sslmode=require

# ─── AI Integration (OpenRouter / LLMs) ───
OPENROUTER_API_KEY=your_openrouter_api_key_here
