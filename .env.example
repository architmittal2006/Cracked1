# ══════════════════════════════════════════════════════════════════════════════
# CRACKED? — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your own values.
# Never commit .env with real secrets.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database (Persistent PostgreSQL — required) ───
# Provision via Render Postgres, Neon, or Supabase. No data on local filesystem.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ─── Session Secret ───
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_random_session_secret_change_in_production

# ─── Client Origin (for CORS + OAuth redirect URIs) ───
# Production: https://your-app.onrender.com or your custom domain
# Development: http://localhost:5174
CLIENT_ORIGIN=http://localhost:5174

# ─── Server ───
PORT=8080
NODE_ENV=development

# ─── OAuth (optional — GitHub/Google login) ───
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Base URL (for OAuth callbacks) ───
BASE_URL=http://localhost:5174
